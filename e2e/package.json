{
  "name": "@minigames/e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "End-to-end browser tests for the player flow. Self-contained: not part of the frontend npm workspace, so Playwright never enters the app builds.",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "install-browsers": "playwright install --with-deps chromium",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "jsqr": "^1.4.0",
    "typescript": "^5.7.2"
  }
}
